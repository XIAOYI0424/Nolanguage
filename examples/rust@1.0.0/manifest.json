{
  "id": "rust",
  "displayName": "Rust",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "publisher": "example",
  "description": "Rust compiled with rustc and run from the same scratch directory. rust-analyzer gives this plugin the full navigation set when it is installed.",
  "order": 52,
  "trust": {
    "sandbox": "subprocess"
  },
  "file": {
    "extensions": [
      "rs"
    ],
    "defaultExt": "rs",
    "fileName": "main.rs"
  },
  "grammar": {
    "rules": [
      {
        "re": "//[^\\n]*",
        "cls": "c"
      },
      {
        "re": "/\\*[\\s\\S]*?\\*/",
        "cls": "c"
      },
      {
        "re": "r#*\"[\\s\\S]*?\"#*",
        "cls": "s"
      },
      {
        "re": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
        "cls": "s"
      },
      {
        "re": "'(?:[^'\\\\\\n]|\\\\.)'",
        "cls": "s"
      },
      {
        "re": "#!?\\[[^\\]]*\\]",
        "cls": "d"
      },
      {
        "re": "\\b(?:as|async|await|break|const|continue|crate|dyn|else|enum|extern|false|fn|for|if|impl|in|let|loop|match|mod|move|mut|pub|ref|return|self|Self|static|struct|super|trait|true|type|unsafe|use|where|while|yield|box|macro_rules)\\b",
        "cls": "k"
      },
      {
        "re": "\\b(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|String|Vec|Option|Result|Some|None|Ok|Err|Box|Rc|Arc|HashMap|HashSet|println|print|format|vec|panic|assert|assert_eq|unwrap|expect)\\b",
        "cls": "b"
      },
      {
        "re": "\\b[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[iufl]*(?:8|16|32|64|128|size)?\\b",
        "cls": "n"
      },
      {
        "re": "[A-Za-z_][A-Za-z0-9_]*(?=\\()",
        "cls": "f"
      },
      {
        "re": "\\b[A-Z][A-Za-z0-9_]*\\b",
        "cls": "cl"
      }
    ]
  },
  "dependencies": {
    "format": "cargo",
    "files": [
      "Cargo.toml"
    ],
    "install": [
      "cargo",
      "add"
    ]
  },
  "scaffold": {
    "onFirstRun": [
      {
        "file": "Cargo.toml",
        "template": "[package]\nname = \"nl_main\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[[bin]]\nname = \"nl_main\"\npath = \"main.rs\"\n"
      }
    ],
    "projectFiles": [
      "Cargo.toml"
    ],
    "templates": [
      {
        "id": "bin",
        "name": "Rust 二进制 crate",
        "description": "Cargo.toml + src/main.rs",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{name}}",
        "params": [
          {
            "key": "name",
            "label": "crate 名",
            "kind": "text",
            "default": "demo",
            "required": true,
            "pattern": "^[a-z][a-z0-9_]*$",
            "hint": "小写字母开头，只能含小写字母、数字、下划线",
            "group": "项目坐标"
          },
          {
            "key": "edition",
            "label": "Edition",
            "kind": "select",
            "default": "2021",
            "options": [
              {
                "value": "2021",
                "label": "2021"
              },
              {
                "value": "2024",
                "label": "2024"
              }
            ],
            "group": "技术栈"
          }
        ],
        "files": [
          {
            "path": "Cargo.toml",
            "template": "[package]\nname = \"{{name}}\"\nversion = \"0.1.0\"\nedition = \"{{edition}}\"\n\n[dependencies]\n"
          },
          {
            "path": "src/main.rs",
            "template": "fn main() {\n    println!(\"hello from {{name}}\");\n}\n\n#[cfg(test)]\nmod tests {\n    #[test]\n    fn it_works() {\n        assert_eq!(2 + 2, 4);\n    }\n}\n"
          },
          {
            "path": ".gitignore",
            "template": "/target\n"
          }
        ]
      },
      {
        "id": "axum-service",
        "name": "Axum HTTP 服务",
        "description": "Cargo.toml + axum/tokio 依赖 + 路由测试，可用「拉取依赖」执行 cargo fetch",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{name}}",
        "params": [
          { "key": "name", "label": "crate 名", "kind": "text", "default": "demo-axum", "required": true, "pattern": "^[a-z][a-z0-9_-]*$", "hint": "小写字母开头，只能含小写字母、数字、下划线、连字符", "group": "项目坐标" },
          { "key": "edition", "label": "Edition", "kind": "select", "default": "2021", "options": [{ "value": "2021", "label": "2021" }, { "value": "2024", "label": "2024" }], "group": "技术栈" }
        ],
        "files": [
          { "path": "Cargo.toml", "template": "[package]\nname = \"{{name}}\"\nversion = \"0.1.0\"\nedition = \"{{edition}}\"\n\n[dependencies]\naxum = \"0.7\"\ntokio = { version = \"1\", features = [\"macros\", \"rt-multi-thread\"] }\nserde_json = \"1\"\ntower = { version = \"0.4\", features = [\"util\"] }\n" },
          { "path": "src/main.rs", "template": "use axum::{routing::get, Json, Router};\nuse serde_json::json;\n\nfn app() -> Router {\n    Router::new().route(\"/hello\", get(|| async { Json(json!({ \"message\": \"hello from {{name}}\" })) }))\n}\n\n#[tokio::main]\nasync fn main() {\n    let listener = tokio::net::TcpListener::bind(\"0.0.0.0:3000\").await.unwrap();\n    axum::serve(listener, app()).await.unwrap();\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use axum::body::Body;\n    use axum::http::{Request, StatusCode};\n    use tower::ServiceExt;\n\n    #[tokio::test]\n    async fn hello_returns_json() {\n        let response = app()\n            .oneshot(Request::builder().uri(\"/hello\").body(Body::empty()).unwrap())\n            .await\n            .unwrap();\n        assert_eq!(response.status(), StatusCode::OK);\n    }\n}\n" },
          { "path": ".gitignore", "template": "/target\n" },
          { "path": "README.md", "template": "# {{name}}\n\nAxum · Rust {{edition}}。\n\n```\ncargo fetch\ncargo run\n```\n\n依赖声明都在 Cargo.toml；用「添加依赖」写坐标后再点「拉取依赖」执行 `cargo fetch`。\n" }
        ]
      },
      {
        "id": "module-file",
        "name": "Rust 模块文件",
        "description": "src/<模块>.rs，带一个单元测试",
        "source": "builtin",
        "kind": "file",
        "suggestedDir": "",
        "params": [
          {
            "key": "name",
            "label": "模块名",
            "kind": "text",
            "default": "util",
            "required": true,
            "pattern": "^[a-z][a-z0-9_]*$",
            "hint": "小写字母开头，只能含小写字母、数字、下划线",
            "group": "文件"
          }
        ],
        "files": [
          {
            "path": "src/{{name}}.rs",
            "template": "pub fn hello() -> &'static str {\n    \"hello from {{name}}\"\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn says_hello() {\n        assert!(hello().contains(\"{{name}}\"));\n    }\n}\n"
          }
        ]
      }
    ]
  },
  "lsp": {
    "provider": {
      "kind": "github",
      "package": "rust-lang/rust-analyzer",
      "asset": "rust-analyzer.exe"
    },
    "discovery": {
      "commands": [
        "rust-analyzer"
      ],
      "envVars": [
        "RUST_ANALYZER"
      ],
      "knownPaths": [
        "~/.cargo/bin/rust-analyzer.exe",
        "~/.cargo/bin/rust-analyzer",
        "C:/Program Files/Rust/bin/rust-analyzer.exe"
      ]
    },
    "args": [],
    "languageId": "rust",
    "serverName": "rust-analyzer",
    "memoryHint": "250MB",
    "degradedNote": "rust-analyzer not installed - Run works, Check and completion do not"
  },
  "run": {
    "mode": "template",
    "requires": [
      "template@^1.0.0"
    ],
    "timeoutMs": 60000,
    "sourceExt": ".rs",
    "discovery": {
      "commands": [
        "rustc"
      ],
      "envVars": [
        "RUSTC"
      ],
      "knownPaths": [
        "~/.cargo/bin/rustc.exe",
        "~/.cargo/bin/rustc",
        "C:/Program Files/Rust/bin/rustc.exe"
      ]
    },
    "versionArgs": [
      "--version"
    ],
    "steps": [
      {
        "role": "build",
        "cmd": "\"{toolchain}\" --edition 2021 -O -o \"{workdir}/nl_main{exe}\" \"{file}\""
      },
      {
        "role": "run",
        "cmd": "\"{workdir}/nl_main{exe}\""
      }
    ],
    "modes": {
      "test": {
        "steps": [
          {
            "role": "build",
            "cmd": "\"{toolchain}\" --edition 2021 --test -o \"{workdir}/nl_test{exe}\" \"{file}\""
          },
          {
            "role": "run",
            "cmd": "\"{workdir}/nl_test{exe}\""
          }
        ]
      }
    }
  },
  "debug": {
    "adapter": "codelldb",
    "type": "cppdbg",
    "discovery": {
      "commands": [
        "codelldb"
      ],
      "envVars": [
        "CODELLDB"
      ],
      "knownPaths": [
        "~/.local/bin/codelldb",
        "C:/Users/Public/codelldb/adapter/codelldb.exe"
      ]
    },
    "command": [
      "{resolved}",
      "--port",
      "0"
    ],
    "preLaunch": {
      "argv": ["{toolchain}", "--edition", "2021", "-g", "-o", "{workdir}/nl_dbg{exe}", "{file}"],
      "timeoutMs": 120000
    },
    "launch": {
      "program": "{workdir}/nl_dbg{exe}",
      "cwd": "{cwd}",
      "args": "{args}",
      "stopOnEntry": "{stopOnEntry}",
      "MIMode": "lldb"
    },
    "serverName": "codelldb",
    "memoryHint": "120MB",
    "degradedNote": "codelldb not installed - debugging is unavailable for Rust",
    "supportsAttach": true
  }
}
