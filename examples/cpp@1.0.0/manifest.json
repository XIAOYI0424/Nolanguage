{
  "id": "cpp",
  "displayName": "C++",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "publisher": "example",
  "description": "C++ compiled with g++, clang++ or c++, then run from the same scratch directory. An example plugin: copy it, change the toolchain list, install it.",
  "order": 50,
  "trust": {
    "sandbox": "subprocess"
  },
  "file": {
    "extensions": [
      "cpp",
      "cc",
      "cxx",
      "c++",
      "hpp",
      "hh",
      "hxx",
      "h"
    ],
    "defaultExt": "cpp",
    "fileName": "main.cpp"
  },
  "grammar": {
    "rules": [
      {
        "re": "#[^\\n]*",
        "cls": "d"
      },
      {
        "re": "//[^\\n]*",
        "cls": "c"
      },
      {
        "re": "/\\*[\\s\\S]*?\\*/",
        "cls": "c"
      },
      {
        "re": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
        "cls": "s"
      },
      {
        "re": "'(?:[^'\\\\\\n]|\\\\.)*'",
        "cls": "s"
      },
      {
        "re": "\\b(?:alignas|alignof|asm|auto|bool|break|case|catch|char|class|const|constexpr|const_cast|continue|decltype|default|delete|do|double|dynamic_cast|else|enum|explicit|export|extern|false|float|for|friend|goto|if|inline|int|long|mutable|namespace|new|noexcept|nullptr|operator|private|protected|public|register|reinterpret_cast|return|short|signed|sizeof|static|static_cast|struct|switch|template|this|throw|true|try|typedef|typeid|typename|union|unsigned|using|virtual|void|volatile|while)\\b",
        "cls": "k"
      },
      {
        "re": "\\b(?:std|string|vector|map|set|pair|array|tuple|optional|variant|function|size_t|ptrdiff_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|cout|cin|cerr|endl)\\b",
        "cls": "b"
      },
      {
        "re": "\\b[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[fFlLuU]*\\b",
        "cls": "n"
      },
      {
        "re": "[A-Za-z_][A-Za-z0-9_]*(?=\\()",
        "cls": "f"
      },
      {
        "re": "\\b[A-Z][A-Za-z0-9_]*\\b",
        "cls": "cl"
      }
    ]
  },
  "scaffold": {
    "templates": [
      {
        "id": "cmake-app",
        "name": "CMake 可执行程序",
        "description": "CMakeLists.txt + src + 可选测试，clangd 可直接索引 compile_commands.json",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{name}}",
        "params": [
          { "key": "name", "label": "项目名", "kind": "text", "default": "demo-cpp", "required": true, "pattern": "^[a-z][a-z0-9_-]*$", "hint": "小写字母开头，只能含小写字母、数字、下划线、连字符", "group": "项目坐标" },
          { "key": "cppStandard", "label": "C++ 标准", "kind": "select", "default": "20", "options": [{ "value": "17", "label": "C++17" }, { "value": "20", "label": "C++20" }], "group": "技术栈" },
          { "key": "withTests", "label": "生成测试", "kind": "boolean", "default": true, "group": "选项" }
        ],
        "files": [
          { "path": "CMakeLists.txt", "template": "cmake_minimum_required(VERSION 3.16)\nproject({{name}} LANGUAGES CXX)\n\nset(CMAKE_CXX_STANDARD {{cppStandard}})\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\nset(CMAKE_EXPORT_COMPILE_COMMANDS ON)\n\nadd_executable({{name}} src/main.cpp)\n\nenable_testing()\nif(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/tests/test_main.cpp)\n  add_executable(unit_test tests/test_main.cpp)\n  add_test(NAME unit_test COMMAND unit_test)\nendif()\n" },
          { "path": "src/add.hpp", "template": "#pragma once\n\ninline int add(int a, int b) {\n  return a + b;\n}\n" },
          { "path": "src/main.cpp", "template": "#include <cstdio>\n\n#include \"add.hpp\"\n\nint main() {\n  std::printf(\"hello from {{name}}: %d\\n\", add(20, 22));\n  return 0;\n}\n" },
          { "path": "tests/test_main.cpp", "when": "withTests", "template": "#include <cassert>\n\n#include \"../src/add.hpp\"\n\nint main() {\n  assert(add(20, 22) == 42);\n  return 0;\n}\n" },
          { "path": ".gitignore", "template": "build/\n" },
          { "path": "README.md", "template": "# {{name}}\n\nCMake · C++{{cppStandard}}。\n\n```\ncmake -S . -B build\ncmake --build build\nctest --test-dir build\n```\n\n`compile_commands.json` 会让 clangd 使用模板声明的包含路径与标准。\n" }
        ]
      }
    ]
  },
  "lsp": {
    "provider": {
      "kind": "github",
      "package": "clangd/clangd",
      "asset": "clangd.exe"
    },
    "discovery": {
      "commands": [
        "clangd"
      ],
      "envVars": [
        "CLANGD"
      ],
      "knownPaths": [
        "C:/Program Files/LLVM/bin/clangd.exe",
        "C:/msys64/mingw64/bin/clangd.exe",
        "/usr/bin/clangd",
        "/usr/local/bin/clangd",
        "~/.local/bin/clangd"
      ]
    },
    "command": [
      "{resolved}"
    ],
    "languageId": "cpp",
    "serverName": "clangd",
    "memoryHint": "500MB",
    "diagnosticsTimeoutMs": 6000,
    "coldDiagnosticsTimeoutMs": 30000,
    "degradedNote": "clangd not installed - Run works, Check and completion do not",
    "args": []
  },
  "run": {
    "mode": "template",
    "requires": [
      "template@^1.0.0"
    ],
    "timeoutMs": 30000,
    "sourceExt": ".cpp",
    "discovery": {
      "commands": [
        "g++",
        "clang++",
        "c++"
      ],
      "envVars": [
        "CXX"
      ],
      "knownPaths": [
        "C:/mingw64/bin/g++.exe",
        "C:/msys64/mingw64/bin/g++.exe",
        "C:/Program Files/LLVM/bin/clang++.exe",
        "/usr/bin/g++",
        "/usr/local/bin/g++",
        "~/.local/bin/g++"
      ]
    },
    "versionArgs": [
      "--version"
    ],
    "steps": [
      {
        "role": "build",
        "cmd": "\"{toolchain}\" -std=c++17 -O0 \"{file}\" -o \"{workdir}/nl_main{exe}\""
      },
      {
        "role": "run",
        "cmd": "\"{workdir}/nl_main{exe}\""
      }
    ],
    "modes": {
      "test": {
        "timeoutMs": 60000,
        "steps": [
          {
            "role": "build",
            "cmd": "\"{toolchain}\" -std=c++17 \"{file}\" -o \"{workdir}/nl_main{exe}\""
          },
          {
            "role": "test",
            "cmd": "\"{workdir}/nl_main{exe}\""
          }
        ]
      }
    }
  },
  "debug": {
    "adapter": "codelldb",
    "type": "cppdbg",
    "discovery": {
      "commands": [
        "codelldb"
      ],
      "envVars": [
        "CODELLDB"
      ],
      "knownPaths": [
        "~/.local/bin/codelldb",
        "C:/Users/Public/codelldb/adapter/codelldb.exe"
      ]
    },
    "command": [
      "{resolved}",
      "--port",
      "0"
    ],
    "preLaunch": {
      "cmd": "\"{toolchain}\" -std=c++17 -g -O0 \"{file}\" -o \"{workdir}/nl_dbg{exe}\"",
      "timeoutMs": 60000
    },
    "launch": {
      "program": "{workdir}/nl_dbg{exe}",
      "cwd": "{cwd}",
      "args": "{args}",
      "stopOnEntry": "{stopOnEntry}",
      "MIMode": "lldb"
    },
    "serverName": "codelldb",
    "memoryHint": "120MB",
    "degradedNote": "codelldb not installed - debugging is unavailable for C++",
    "supportsAttach": true
  }
}
