{
  "id": "javascript",
  "displayName": "JavaScript",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "publisher": "nolanguage",
  "description": "JavaScript evaluated in an embedded VM, with a fresh context per run.",
  "order": 30,
  "trust": {
    "sandbox": "none"
  },
  "file": {
    "extensions": [
      "js",
      "mjs",
      "cjs",
      "jsx"
    ],
    "defaultExt": "js",
    "fileName": "main.js"
  },
  "grammar": {
    "rules": [
      {
        "re": "//[^\\n]*",
        "cls": "c"
      },
      {
        "re": "/\\*[\\s\\S]*?\\*/",
        "cls": "c"
      },
      {
        "re": "`[^`]*`",
        "cls": "s"
      },
      {
        "re": "\"[^\"]*\"",
        "cls": "s"
      },
      {
        "re": "'[^']*'",
        "cls": "s"
      },
      {
        "re": "\\b(?:const|let|var|function|return|if|else|for|while|do|class|extends|new|import|export|from|default|async|await|try|catch|finally|throw|typeof|instanceof|of|in|void|delete|switch|case|break|continue|null|undefined|true|false|this|super|yield|interface|type|enum|public|private|protected|readonly|as)\\b",
        "cls": "k"
      },
      {
        "re": "\\b(?:console|process|globalThis|Math|JSON|Object|Array|Number|String|Boolean|Symbol|BigInt|Promise|Map|Set|WeakMap|Date|RegExp|Error|TypeError|RangeError|SyntaxError|parseInt|parseFloat|isNaN|structuredClone)\\b",
        "cls": "b"
      },
      {
        "re": "[0-9][0-9_]*(?:\\.[0-9]+)?",
        "cls": "n"
      },
      {
        "re": "[A-Za-z_$][A-Za-z0-9_$]*(?=\\()",
        "cls": "f"
      }
    ]
  },
  "lsp": {
    "provider": {
      "kind": "npm",
      "package": "typescript-language-server",
      "version": "6.1.0",
      "bin": "typescript-language-server",
      "also": [
        "typescript@5.6.3"
      ]
    },
    "discovery": {
      "commands": [
        "typescript-language-server"
      ],
      "envVars": [
        "JS_LSP"
      ],
      "knownPaths": []
    },
    "command": [
      "{resolved}"
    ],
    "languageId": "javascript",
    "serverName": "tsserver",
    "memoryHint": "150MB",
    "degradedNote": "typescript-language-server not installed — Run works, Check and completion do not",
    "args": [
      "--stdio"
    ]
  },
  "run": {
    "mode": "inline-vm",
    "requires": [
      "inline-vm@^1.0.0"
    ],
    "sourceExt": ".js",
    "timeoutMs": 5000,
    "vmTimeoutMs": 5000,
    "interpreters": {
      "envDirs": [],
      "envBins": [],
      "marker": "package.json",
      "exeNames": [
        "node.exe",
        "node"
      ],
      "versionDirs": [
        ".nvm/versions/node",
        ".volta/tools/image/node"
      ],
      "versionBins": [
        "node.exe",
        "bin/node"
      ],
      "versionArgs": [
        "--version"
      ],
      "sdkPrefix": "Node.js"
    }
  },
  "dependencies": {
    "format": "npm",
    "files": [
      "package.json"
    ],
    "install": [
      "npm",
      "install"
    ]
  },
  "scaffold": {
    "templates": [
      {
        "id": "node-cli",
        "name": "Node CLI",
        "description": "package.json + 可执行入口",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{name}}",
        "params": [
          {
            "key": "name",
            "label": "包名",
            "kind": "text",
            "default": "demo-cli",
            "required": true,
            "pattern": "^[a-z][a-z0-9-]*$",
            "hint": "小写字母开头，只能含小写字母、数字、连字符",
            "group": "项目坐标"
          },
          {
            "key": "module",
            "label": "模块格式",
            "kind": "select",
            "default": "esm",
            "options": [
              {
                "value": "esm",
                "label": "ESM (import)"
              },
              {
                "value": "cjs",
                "label": "CommonJS (require)"
              }
            ],
            "group": "技术栈"
          }
        ],
        "files": [
          {
            "path": "package.json",
            "template": "{\n  \"name\": \"{{name}}\",\n  \"version\": \"0.1.0\",\n  \"type\": \"{{module}}\",\n  \"bin\": { \"{{name}}\": \"./index.js\" }\n}\n"
          },
          {
            "path": "index.js",
            "template": "#!/usr/bin/env node\n\nfunction main(argv) {\n  console.log('hello from {{name}}', argv.slice(2).join(' '));\n}\n\nmain(process.argv);\n"
          },
          {
            "path": "README.md",
            "template": "# {{name}}\n\n```\nnode index.js\n```\n"
          }
        ]
      },
      {
        "id": "vite-react-ts",
        "name": "Vite + React + TypeScript",
        "description": "可运行的前端工程：固定版本依赖 + tsconfig + 一个示例页面",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{name}}",
        "params": [
          { "key": "name", "label": "项目名", "kind": "text", "default": "demo-web", "required": true, "pattern": "^[a-z][a-z0-9-]*$", "hint": "小写字母开头，只能含小写字母、数字、连字符", "group": "项目坐标" }
        ],
        "files": [
          { "path": "package.json", "template": "{\n  \"name\": \"{{name}}\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"tsc --noEmit && vite build\",\n    \"preview\": \"vite preview\"\n  },\n  \"dependencies\": {\n    \"react\": \"^18.3.1\",\n    \"react-dom\": \"^18.3.1\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"^18.3.12\",\n    \"@types/react-dom\": \"^18.3.1\",\n    \"@vitejs/plugin-react\": \"^4.3.4\",\n    \"typescript\": \"^5.6.3\",\n    \"vite\": \"^5.4.11\"\n  }\n}\n" },
          { "path": "tsconfig.json", "template": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"jsx\": \"react-jsx\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true\n  },\n  \"include\": [\"src\", \"vite.config.ts\"]\n}\n" },
          { "path": "vite.config.ts", "template": "import { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\n\nexport default defineConfig({ plugins: [react()] });\n" },
          { "path": "index.html", "template": "<!doctype html>\n<html lang=\"zh-CN\">\n  <head><meta charset=\"UTF-8\"><title>{{name}}</title></head>\n  <body><div id=\"root\"></div><script type=\"module\" src=\"/src/main.tsx\"></script></body>\n</html>\n" },
          { "path": "src/main.tsx", "template": "import React from 'react';\nimport ReactDOM from 'react-dom/client';\nimport App from './App';\n\nReactDOM.createRoot(document.getElementById('root')!).render(\n  <React.StrictMode><App /></React.StrictMode>,\n);\n" },
          { "path": "src/App.tsx", "template": "export default function App() {\n  return <main><h1>hello from {{name}}</h1><p>Edit src/App.tsx to get started.</p></main>;\n}\n" },
          { "path": ".gitignore", "template": "node_modules/\ndist/\n" },
          { "path": "README.md", "template": "# {{name}}\n\nVite + React + TypeScript。\n\n```\nnpm install\nnpm run dev\n```\n\n「拉取依赖」在有 package-lock.json 时使用 `npm ci`，否则使用 `npm install`。\n" }
        ]
      },
      {
        "id": "module-file",
        "name": "JS 模块文件",
        "description": "<模块>.js，导出一个函数",
        "source": "builtin",
        "kind": "file",
        "suggestedDir": "",
        "params": [
          {
            "key": "name",
            "label": "模块名",
            "kind": "text",
            "default": "util",
            "required": true,
            "pattern": "^[a-z][a-z0-9-]*$",
            "hint": "小写字母开头，只能含小写字母、数字、连字符",
            "group": "文件"
          }
        ],
        "files": [
          {
            "path": "{{name}}.js",
            "template": "export function {{name}}() {\n  return 'hello from {{name}}';\n}\n"
          }
        ]
      }
    ]
  }
}
