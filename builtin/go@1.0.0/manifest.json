{
  "id": "go",
  "displayName": "Go",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "publisher": "nolanguage",
  "description": "Go, compiled into a per-session module directory. Supports both run and test modes.",
  "order": 20,
  "trust": {
    "sandbox": "subprocess"
  },
  "file": {
    "extensions": [
      "go"
    ],
    "defaultExt": "go",
    "fileName": "main.go"
  },
  "grammar": {
    "rules": [
      {
        "re": "//[^\\n]*",
        "cls": "c"
      },
      {
        "re": "/\\*[\\s\\S]*?\\*/",
        "cls": "c"
      },
      {
        "re": "`[^`]*`",
        "cls": "s"
      },
      {
        "re": "\"[^\"]*\"",
        "cls": "s"
      },
      {
        "re": "'[^']*'",
        "cls": "s"
      },
      {
        "re": "\\b(?:package|import|func|return|if|else|for|range|var|const|type|struct|interface|map|chan|go|defer|select|switch|case|default|break|continue|nil|true|false|make|new|append|len|cap)\\b",
        "cls": "k"
      },
      {
        "re": "\\b(?:string|int|int8|int16|int32|int64|uint|uint64|float32|float64|bool|byte|rune|error|any)\\b",
        "cls": "b"
      },
      {
        "re": "[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
        "cls": "n"
      },
      {
        "re": "[A-Za-z_][A-Za-z0-9_]*(?=\\()",
        "cls": "f"
      }
    ]
  },
  "scaffold": {
    "required": true,
    "onFirstRun": [
      {
        "file": "go.mod",
        "template": "// Generated by Nolanguage — one module per session.\nmodule nolanguage/session\n\ngo 1.21\n"
      }
    ],
    "projectFiles": [
      "go.mod"
    ],
    "templates": [
      {
        "id": "module",
        "name": "Go module",
        "description": "go.mod + main.go",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{dir}}",
        "params": [
          {
            "key": "module",
            "label": "模块路径",
            "kind": "text",
            "default": "example.com/demo",
            "required": true,
            "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$",
            "hint": "形如 example.com/你的模块",
            "group": "项目坐标"
          },
          {
            "key": "dir",
            "label": "目录名",
            "kind": "text",
            "default": "demo",
            "required": true,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "hint": "小写字母开头",
            "group": "项目坐标"
          },
          {
            "key": "goVersion",
            "label": "Go 版本",
            "kind": "select",
            "default": "1.22",
            "options": [
              {
                "value": "1.21",
                "label": "1.21"
              },
              {
                "value": "1.22",
                "label": "1.22"
              },
              {
                "value": "1.23",
                "label": "1.23"
              }
            ],
            "group": "技术栈"
          },
          {
            "key": "withTest",
            "label": "生成测试",
            "kind": "boolean",
            "default": true,
            "group": "选项"
          }
        ],
        "files": [
          {
            "path": "go.mod",
            "template": "module {{module}}\n\ngo {{goVersion}}\n"
          },
          {
            "path": "main.go",
            "template": "package main\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println(\"hello from {{module}}\")\n}\n"
          },
          {
            "path": "main_test.go",
            "when": "withTest",
            "template": "package main\n\nimport \"testing\"\n\nfunc TestNothing(t *testing.T) {\n\tif 2+2 != 4 {\n\t\tt.Fatal(\"math is broken\")\n\t}\n}\n"
          }
        ]
      },
      {
        "id": "test-file",
        "name": "Go 测试文件",
        "description": "<模块>_test.go，带一个用例",
        "source": "builtin",
        "kind": "file",
        "suggestedDir": "",
        "params": [
          {
            "key": "name",
            "label": "被测包/文件前缀",
            "kind": "text",
            "default": "main",
            "required": true,
            "pattern": "^[a-z][a-z0-9_]*$",
            "hint": "小写字母开头，只能含小写字母、数字、下划线",
            "group": "文件"
          }
        ],
        "files": [
          {
            "path": "{{name}}_test.go",
            "template": "package main\n\nimport \"testing\"\n\nfunc TestGenerated(t *testing.T) {\n\tif 1+1 != 2 {\n\t\tt.Fatal(\"math is broken\")\n\t}\n}\n"
          }
        ]
      }
    ]
  },
  "lsp": {
    "provider": {
      "kind": "go-install",
      "package": "golang.org/x/tools/gopls",
      "version": "v0.24.0"
    },
    "discovery": {
      "commands": [
        "gopls"
      ],
      "envVars": [
        "GOPLS_BIN"
      ],
      "knownPaths": [
        "~/go/bin/gopls.exe",
        "~/go/bin/gopls"
      ]
    },
    "command": [
      "{resolved}"
    ],
    "languageId": "go",
    "serverName": "gopls",
    "memoryHint": "80MB",
    "requiresProjectFile": "go.mod",
    "diagnosticsTimeoutMs": 6000,
    "coldDiagnosticsTimeoutMs": 20000,
    "degradedNote": "gopls not installed — Run works, Check and completion do not"
  },
  "run": {
    "mode": "directory-session",
    "requires": [
      "directory-session@^1.0.0"
    ],
    "timeoutMs": 30000,
    "sourceExt": ".go",
    "discovery": {
      "commands": [
        "go"
      ],
      "envVars": [
        "GO_BIN"
      ],
      "knownPaths": [
        "D:/Go lang/bin/go.exe",
        "C:/Program Files/Go/bin/go.exe",
        "~/.local/go/bin/go",
        "/usr/local/go/bin/go"
      ]
    },
    "steps": [
      {
        "role": "build",
        "cmd": "\"{toolchain}\" build -o \"{workdir}/nl_main{exe}\" {file}"
      },
      {
        "role": "run",
        "cmd": "\"{workdir}/nl_main{exe}\""
      }
    ],
    "modes": {
      "test": {
        "timeoutMs": 60000,
        "steps": [
          {
            "role": "test",
            "cmd": "\"{toolchain}\" test -v -count=1 ."
          }
        ]
      }
    },
    "versionArgs": [
      "version"
    ],
    "command": [
      "{toolchain}"
    ],
    "interpreters": {
      "envDirs": [],
      "envBins": [],
      "marker": "go.mod",
      "exeNames": [
        "go.exe",
        "go"
      ],
      "versionDirs": [
        "go/bin",
        "scoop/apps/go/current/bin"
      ],
      "versionBins": [
        "go.exe",
        "go"
      ],
      "versionArgs": [
        "version"
      ],
      "sdkPrefix": "Go"
    }
  },
  "profiler": {
    "adapter": "pprof",
    "memoryHint": "50MB"
  },
  "debug": {
    "adapter": "delve",
    "type": "go",
    "discovery": {
      "commands": [
        "dlv"
      ],
      "envVars": [
        "DLV_BIN"
      ],
      "knownPaths": [
        "~/go/bin/dlv",
        "~/go/bin/dlv.exe"
      ]
    },
    "command": [
      "{resolved}",
      "dap"
    ],
    "serverName": "delve",
    "memoryHint": "80MB",
    "degradedNote": "delve not installed - debugging is unavailable for Go",
    "install": "go install github.com/go-delve/delve/cmd/dlv@latest",
    "supportsAttach": true
  },
  "dependencies": {
    "format": "gomod",
    "files": [
      "go.mod"
    ],
    "install": [
      "{toolchain}",
      "get"
    ]
  }
}
