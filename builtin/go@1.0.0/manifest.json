{
  "id": "go",
  "displayName": "Go",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "publisher": "nolanguage",
  "description": "Go, compiled into a per-session module directory. Supports both run and test modes.",
  "order": 20,
  "trust": {
    "sandbox": "subprocess"
  },
  "file": {
    "extensions": [
      "go"
    ],
    "defaultExt": "go",
    "fileName": "main.go"
  },
  "grammar": {
    "rules": [
      {
        "re": "//[^\\n]*",
        "cls": "c"
      },
      {
        "re": "/\\*[\\s\\S]*?\\*/",
        "cls": "c"
      },
      {
        "re": "`[^`]*`",
        "cls": "s"
      },
      {
        "re": "\"[^\"]*\"",
        "cls": "s"
      },
      {
        "re": "'[^']*'",
        "cls": "s"
      },
      {
        "re": "\\b(?:package|import|func|return|if|else|for|range|var|const|type|struct|interface|map|chan|go|defer|select|switch|case|default|break|continue|nil|true|false|make|new|append|len|cap)\\b",
        "cls": "k"
      },
      {
        "re": "\\b(?:string|int|int8|int16|int32|int64|uint|uint64|float32|float64|bool|byte|rune|error|any)\\b",
        "cls": "b"
      },
      {
        "re": "[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
        "cls": "n"
      },
      {
        "re": "[A-Za-z_][A-Za-z0-9_]*(?=\\()",
        "cls": "f"
      }
    ]
  },
  "scaffold": {
    "required": true,
    "onFirstRun": [
      {
        "file": "go.mod",
        "template": "// Generated by Nolanguage — one module per session.\nmodule nolanguage/session\n\ngo 1.21\n"
      }
    ],
    "projectFiles": [
      "go.mod"
    ]
  },
  "lsp": {
    "provider": {
      "kind": "go-install",
      "package": "golang.org/x/tools/gopls",
      "version": "v0.24.0"
    },
    "discovery": {
      "commands": [
        "gopls"
      ],
      "envVars": [
        "GOPLS_BIN"
      ],
      "knownPaths": [
        "~/go/bin/gopls.exe",
        "~/go/bin/gopls"
      ]
    },
    "command": [
      "{resolved}"
    ],
    "languageId": "go",
    "serverName": "gopls",
    "memoryHint": "80MB",
    "requiresProjectFile": "go.mod",
    "diagnosticsTimeoutMs": 6000,
    "coldDiagnosticsTimeoutMs": 20000,
    "degradedNote": "gopls not installed — Run works, Check and completion do not"
  },
  "run": {
    "mode": "directory-session",
    "requires": [
      "directory-session@^1.0.0"
    ],
    "timeoutMs": 30000,
    "sourceExt": ".go",
    "discovery": {
      "commands": [
        "go"
      ],
      "envVars": [
        "GO_BIN"
      ],
      "knownPaths": [
        "D:/Go lang/bin/go.exe",
        "C:/Program Files/Go/bin/go.exe",
        "~/.local/go/bin/go",
        "/usr/local/go/bin/go"
      ]
    },
    "steps": [
      {
        "role": "build",
        "cmd": "\"{toolchain}\" build -o \"{workdir}/nl_main{exe}\" {file}"
      },
      {
        "role": "run",
        "cmd": "\"{workdir}/nl_main{exe}\""
      }
    ],
    "modes": {
      "test": {
        "timeoutMs": 60000,
        "steps": [
          {
            "role": "test",
            "cmd": "\"{toolchain}\" test -v -count=1 ."
          }
        ]
      }
    },
    "versionArgs": [
      "version"
    ],
    "command": [
      "{toolchain}"
    ],
    "interpreters": {
      "envDirs": [],
      "envBins": [],
      "marker": "go.mod",
      "exeNames": [
        "go.exe",
        "go"
      ],
      "versionDirs": [
        "go/bin",
        "scoop/apps/go/current/bin"
      ],
      "versionBins": [
        "go.exe",
        "go"
      ],
      "versionArgs": [
        "version"
      ],
      "sdkPrefix": "Go"
    }
  },
  "profiler": {
    "adapter": "pprof",
    "memoryHint": "50MB"
  },
  "debug": {
    "adapter": "delve",
    "type": "go",
    "discovery": {
      "commands": [
        "dlv"
      ],
      "envVars": [
        "DLV_BIN"
      ],
      "knownPaths": [
        "~/go/bin/dlv",
        "~/go/bin/dlv.exe"
      ]
    },
    "command": [
      "{resolved}",
      "dap"
    ],
    "serverName": "delve",
    "memoryHint": "80MB",
    "degradedNote": "delve not installed - debugging is unavailable for Go",
    "install": "go install github.com/go-delve/delve/cmd/dlv@latest",
    "supportsAttach": true
  },
  "dependencies": {
    "format": "gomod",
    "files": [
      "go.mod"
    ],
    "install": [
      "{toolchain}",
      "get"
    ]
  }
}
