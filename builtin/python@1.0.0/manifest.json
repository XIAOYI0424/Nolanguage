{
  "id": "python",
  "displayName": "Python",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "publisher": "nolanguage",
  "description": "Python with a persistent interpreter session. Ships the official plugin; the substrate has no Python knowledge.",
  "order": 10,
  "trust": {
    "sandbox": "subprocess"
  },
  "file": {
    "extensions": [
      "py",
      "pyi",
      "pyw"
    ],
    "defaultExt": "py",
    "fileName": "main.py"
  },
  "grammar": {
    "rules": [
      {
        "re": "#[^\\n]*",
        "cls": "c"
      },
      {
        "re": "\"\"\"[\\s\\S]*?\"\"\"",
        "cls": "s"
      },
      {
        "re": "'''[\\s\\S]*?'''",
        "cls": "s"
      },
      {
        "re": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
        "cls": "s"
      },
      {
        "re": "'(?:[^'\\\\\\n]|\\\\.)*'",
        "cls": "s"
      },
      {
        "re": "@[A-Za-z_][A-Za-z0-9_.]*",
        "cls": "d"
      },
      {
        "re": "\\b(?:def|class|return|if|elif|else|for|while|in|not|and|or|import|from|as|with|try|except|finally|raise|yield|lambda|pass|break|continue|global|nonlocal|assert|del|async|await|is|None|True|False)\\b",
        "cls": "k"
      },
      {
        "re": "\\b(?:print|len|range|str|int|float|bool|list|dict|set|tuple|open|sum|min|max|abs|sorted|enumerate|zip|map|filter|type|isinstance|super)\\b",
        "cls": "b"
      },
      {
        "re": "[0-9][0-9_]*(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
        "cls": "n"
      },
      {
        "re": "[A-Za-z_][A-Za-z0-9_]*(?=\\()",
        "cls": "f"
      }
    ]
  },
  "lsp": {
    "provider": {
      "kind": "npm",
      "package": "pyright",
      "version": "1.1.414",
      "bin": "pyright-langserver"
    },
    "discovery": {
      "commands": [
        "pyright-langserver"
      ],
      "envVars": [
        "PYTHON_BIN"
      ],
      "knownPaths": [
        "~/.local/bin/pyright-langserver"
      ]
    },
    "command": [
      "{resolved}"
    ],
    "languageId": "python",
    "serverName": "pyright",
    "memoryHint": "380MB",
    "diagnosticsTimeoutMs": 2500,
    "coldDiagnosticsTimeoutMs": 2500,
    "degradedNote": "pyright not found — Check and completion fall back to the bundled stub server",
    "args": [
      "--stdio"
    ],
    "eager": false,
    "bundledFallback": {
      "languageId": "python",
      "serverName": "nolanguage-py",
      "command": [
        "{toolchain}",
        "-u",
        "{embedded:pyrightServer.py}"
      ],
      "sourceDir": "python"
    }
  },
  "run": {
    "mode": "repl-session",
    "requires": [
      "repl-session@^1.0.0"
    ],
    "timeoutMs": 15000,
    "command": [
      "{toolchain}",
      "-u"
    ],
    "sourceExt": ".py",
    "bootstrap": "bootstrap.py",
    "discovery": {
      "commands": [
        "python",
        "python3"
      ],
      "envVars": [
        "PYTHON_BIN"
      ],
      "knownPaths": [
        "~/.local/bin/python",
        "C:/Python313/python.exe",
        "C:/Python312/python.exe",
        "C:/Python311/python.exe"
      ]
    },
    "versionArgs": [
      "-V"
    ],
    "coverage": true,
    "interpreters": {
      "envDirs": [
        ".venv",
        "venv",
        "env",
        ".env"
      ],
      "envBins": [
        "Scripts/python.exe",
        "bin/python3",
        "bin/python"
      ],
      "marker": "pyvenv.cfg",
      "exeNames": [
        "python.exe",
        "python3.exe",
        "python",
        "python3"
      ],
      "versionDirs": [
        ".pyenv/pyenv-win/versions",
        ".pyenv/versions"
      ],
      "versionBins": [
        "python.exe",
        "bin/python3",
        "bin/python"
      ],
      "envListFile": ".conda/environments.txt",
      "versionArgs": [
        "--version"
      ],
      "sdkPrefix": "Python"
    }
  },
  "profiler": {
    "adapter": "cProfile",
    "memoryHint": "80MB"
  },
  "debug": {
    "adapter": "debugpy",
    "type": "python",
    "discovery": {
      "commands": [
        "debugpy-adapter"
      ],
      "envVars": [
        "DEBUGPY_ADAPTER"
      ],
      "knownPaths": [
        "~/.local/bin/debugpy-adapter"
      ]
    },
    "command": [
      "{resolved}"
    ],
    "args": [],
    "serverName": "debugpy",
    "memoryHint": "60MB",
    "degradedNote": "debugpy not installed - debugging is unavailable for Python",
    "install": "pip install debugpy",
    "supportsAttach": true
  },
  "dependencies": {
    "format": "requirements",
    "files": [
      "requirements.txt",
      {
        "file": "pyproject.toml",
        "format": "pyproject"
      }
    ],
    "install": [
      "{toolchain}",
      "-m",
      "pip",
      "install"
    ]
  },
  "scaffold": {
    "templates": [
      {
        "id": "package",
        "name": "Python 包（src 布局）",
        "description": "pyproject.toml + src 包 + 可选 pytest",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{name}}",
        "params": [
          {
            "key": "name",
            "label": "包名",
            "kind": "text",
            "default": "demo_pkg",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
            "hint": "小写字母开头，只能含字母、数字、下划线",
            "required": true,
            "group": "项目坐标"
          },
          {
            "key": "python",
            "label": "Python 版本",
            "kind": "select",
            "default": "3.12",
            "options": [
              {
                "value": "3.11",
                "label": "3.11"
              },
              {
                "value": "3.12",
                "label": "3.12"
              },
              {
                "value": "3.13",
                "label": "3.13"
              }
            ],
            "group": "技术栈"
          },
          {
            "key": "withTests",
            "label": "生成 pytest 测试",
            "kind": "boolean",
            "default": true,
            "group": "选项"
          }
        ],
        "files": [
          {
            "path": "pyproject.toml",
            "template": "[project]\nname = \"{{name}}\"\nversion = \"0.1.0\"\nrequires-python = \">={{python}}\"\n\n[build-system]\nrequires = [\"setuptools>=68\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n"
          },
          {
            "path": "src/{{name}}/__init__.py",
            "template": "\"\"\"{{name}}\"\"\"\n\n__version__ = \"0.1.0\"\n"
          },
          {
            "path": "src/{{name}}/main.py",
            "template": "def main() -> None:\n    print(\"hello from {{name}}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
          },
          {
            "path": "README.md",
            "template": "# {{name}}\n\nGenerated by Nolanguage.\n"
          },
          {
            "path": "tests/test_main.py",
            "when": "withTests",
            "template": "from {{name}}.main import main\n\n\ndef test_main_runs(capsys):\n    main()\n    assert \"{{name}}\" in capsys.readouterr().out\n"
          }
        ]
      },
      {
        "id": "script",
        "name": "单文件脚本",
        "description": "一个 py 文件加 README，最少结构",
        "source": "builtin",
        "kind": "project",
        "suggestedDir": "{{name}}",
        "params": [
          {
            "key": "name",
            "label": "脚本名",
            "kind": "text",
            "default": "demo_script",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
            "hint": "小写字母开头，只能含字母、数字、下划线",
            "required": true,
            "group": "项目坐标"
          }
        ],
        "files": [
          {
            "path": "{{name}}.py",
            "template": "#!/usr/bin/env python3\n\"\"\"{{name}}.\"\"\"\n\n\ndef main() -> None:\n    print(\"{{name}}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
          },
          {
            "path": "README.md",
            "template": "# {{name}}\n\n```\npython {{name}}.py\n```\n"
          }
        ]
      }
    ]
  }
}
