    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "ndebug": "node --experimental-transform-types --no-warnings --experimental-loader ./resolve-loader.mjs src/debugtool/cli.ts",
    "build:ndebug": "node scripts/build-ndebug.mjs",
    "build:all": "node scripts/build-all.mjs",
    "check:clean": "node scripts/check-release.mjs --push",
    "verify:release": "node scripts/check-release.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "sign": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/sign.ps1",
    "sign:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/sign.ps1 -Verify",
    "build:sign": "npm run build:exe && npm run build:setup && npm run sign -- -SelfSigned",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "verify:pure": "node --experimental-transform-types --no-warnings --experimental-loader ./resolve-loader.mjs scripts/verify-all.mjs --pure",
    "ci:pure": "npm run typecheck && npm test && npm run verify:pure",
    "ci:integration": "npm run build:exe && npm run verify:sidecar && npm run verify && npm run build:setup",
    "ci:install-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/smoke-install.ps1",
    "install:app": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/install-app.ps1",
    "verify:ci": "node --experimental-transform-types --no-warnings --experimental-loader ./resolve-loader.mjs scripts/verify-ci.ts"
