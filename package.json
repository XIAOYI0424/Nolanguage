    "verify:stress": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types scripts/verify-stress.ts",
    "verify:ndebug-go": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types scripts/verify-ndebug-go.ts",
    "verify:redact": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types scripts/verify-redact.ts",
    "verify:sanitize": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types scripts/verify-sanitize.ts",
    "verify:arch": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types scripts/verify-architecture.ts",
    "verify:types": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types scripts/verify-types.ts",
