# ---------------------------------------------------------------------------
# Build output — always regenerated, never committed.
#   dist/           engine SEA images (Nolanguage.exe, NDebug.exe)
#   build/          SEA preparation blobs
#   frontend/dist/  static shell emitted by scripts/build-frontend.mjs
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
frontend/dist/
*.log
.DS_Store

# Tauri shell: Rust build artefacts and the engine sidecar placed next to the
# app (`externalBin` names it `binaries/Nolanguage-<triple>`; `tauri build`
# copies it in, and a bare `cargo build` needs the same copy to run).
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/

# NSIS installer output — rebuilt by `npm run build:setup`.
# Distribute via GitHub Releases, not as a committed binary.
installer/Nolanguage-Setup.exe
installer/payload/Nolanguage.exe
installer/payload/uninstaller.exe
installer/uninstaller/target/
installer/.build/
installer/build-nsis.bat

# Stage 6 · baseline system: local telemetry database + cold-tier archive.
.nolanguage/

# Scratch space for the verification suites (packaged-exe sandbox, explorer
# workspace, ad-hoc probes). Never committed.
.tmp/
tmp/
.tmpdiag/
.test-run.*
.test-out.txt
.verify-run*
.stdio-*
.build-exe.*

# Agent workspace data (memory/logs) and local editor state — never project source.
.workbuddy-ai/
.codebudy/
.obsidian/
.cargo/config.toml

# Python bytecode caches created by probes and debug fixtures.
__pycache__/
*.pyc
