{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Nolanguage",
  "version": "0.7.19",
  "identifier": "ai.codebuddy.nolanguage",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types ./scripts/build-frontend.mjs && node ./scripts/serve-dist.mjs",
    "beforeBuildCommand": "node --experimental-loader ./resolve-loader.mjs --experimental-transform-types ./scripts/build-frontend.mjs && node ./scripts/sync-sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nolanguage",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "devtools": false,
        "zoomHotkeysEnabled": false,
        "backgroundColor": "#1E1F22"
      }
    ],
    "security": {
      "csp": "script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": ["binaries/NolanguageEngine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
